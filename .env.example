# a0_lmm_router standalone provider example environment.
# Copy values into your shell, service manager, or .env loader.

OBSERVER_HOST=127.0.0.1
OBSERVER_PORT=9000
A0_LMM_ROUTER_CONFIG=conf/llama_cpp_servers.yaml
# Optional when harnesses.yaml lives outside the fleet config directory.
# A0_LMM_ROUTER_HARNESSES_CONFIG=conf/harnesses.yaml
A0_FLEET_STATE_DB=
A0_FLEET_MAX_ACTIVE=1
A0_FLEET_MAX_QUEUE=32

# Optional for MCP clients that should use the Fleet Manager API.
# A0_FLEET_MANAGER_BASE_URL=http://127.0.0.1:9000

# Set this before binding to anything other than localhost.
# A0_LMM_ROUTER_API_KEY=change-me

# Let the router start/stop fleet slots (API + dashboard buttons).
# What "start" does follows global.backend in conf/llama_cpp_servers.yaml
# (docker needs the [docker] extra). Off by default: routing only.
# A0_LMM_ROUTER_ENABLE_FLEET_CONTROL=1

# Allow authenticated POST /harnesses writes with atomic backups. Both this
# flag and A0_LMM_ROUTER_API_KEY are required. Off by default.
# A0_LMM_ROUTER_ENABLE_CONFIG_WRITES=1

# Explicit escape hatch for lab-only public no-auth binds.
# Do not enable on shared networks.
# A0_LMM_ROUTER_ALLOW_PUBLIC_NO_AUTH=1

# Optional local iGPU worker defaults used by START IGPU WORKER.bat.
# IGPU_MODEL=C:\path\to\model.gguf
# IGPU_PORT=8089
# IGPU_ALIAS=utility_cpu
# IGPU_VK_DEVICE=1
